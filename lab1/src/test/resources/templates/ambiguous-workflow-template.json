{
  "id": "ambiguous-workflow",
  "title": "Тест ошибки: две одновременно допустимые дуги",
  "classId": "office_order",
  "createRoles": ["order_manager"],
  "actions": [{"id": "choose", "title": "Выбрать"}],
  "predicates": [
    {"id": "positive", "parameterId": "quantity", "operator": ">=", "value": 1},
    {"id": "small", "parameterId": "quantity", "operator": "<=", "value": 500}
  ],
  "states": [
    {"id": "start", "title": "Начало", "initial": true, "final": false, "roles": ["order_manager"], "editParameters": true},
    {"id": "first", "title": "Первая цель", "initial": false, "final": true, "roles": [], "editParameters": false},
    {"id": "second", "title": "Вторая цель", "initial": false, "final": true, "roles": [], "editParameters": false}
  ],
  "transitions": [
    {"from": "start", "action": "choose", "to": "first", "condition": {"groups": [[{"predicateId": "positive", "negated": false}]]}},
    {"from": "start", "action": "choose", "to": "second", "condition": {"groups": [[{"predicateId": "small", "negated": false}]]}}
  ]
}
