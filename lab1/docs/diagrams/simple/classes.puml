@startuml
!pragma layout smetana
title Основные классы: кто за что отвечает
skinparam classAttributeIconSize 0
skinparam defaultFontSize 15
skinparam shadowing false
hide empty members

interface WorkflowEngine {
  +createObject()
  +executeAction()
  +updateParameter()
  +getAccess()
  +getHistory()
}
class WebApplication {
  +start()
  +close()
}
class WorkflowApiController {
  +register()
}
class WorkflowQueryAdapter {
  +object()
  +process()
  +access()
  +history()
}
class BusinessObject {
  id
  classId
  stateId
  parameters
}
class CatalogService {
  +getEffectiveParameters()
}
class TemplateCatalogService {
  +resolveTemplate()
}
class ProcessTemplate {
  classId
  createRoles
}
class StateDefinition {
  id
  initial / terminal
}
class TransitionDefinition {
  from / action / to
  condition
}
interface StateMachine {
  +start()
  +send()
  +stop()
}
class FileRepository {
  +load()
  +commit()
}

WorkflowEngine --> BusinessObject : управляет
WebApplication ..> WorkflowApiController : сборка через фабрику
WebApplication --> WorkflowEngine : жизненный цикл
WorkflowApiController --> WorkflowEngine : команды
WorkflowApiController --> WorkflowQueryAdapter : чтение
WorkflowQueryAdapter --> WorkflowEngine : объект и права
WorkflowQueryAdapter --> TemplateCatalogService : схема
WorkflowEngine --> CatalogService : параметры класса
WorkflowEngine --> TemplateCatalogService : выбирает процесс
WorkflowEngine --> StateMachine : исполняет команды
WorkflowEngine --> FileRepository : сохраняет результат
TemplateCatalogService --> ProcessTemplate : находит
ProcessTemplate *-- StateDefinition : состояния
ProcessTemplate *-- TransitionDefinition : переходы

legend bottom
  Один BusinessObject — один собственный StateMachine.
  Состояния и переходы берутся из ProcessTemplate, а не зашиты в Java.
  Контроллер и DTO не реализуют бизнес-правила.
  Показаны только основные методы и поля.
endlegend
@enduml
