@startuml
!pragma teoz true
title 3-1-1 · Запуск и выполнение команды Б.3
hide footbox
skinparam shadowing false
skinparam defaultFontSize 13
skinparam ParticipantPadding 6
skinparam maxMessageSize 170

actor "Пользователь" as User
boundary "Браузер" as Browser
participant "Task311WebApplication\nTask311ApiController" as Web
participant CoordinationScenario as Scenario
database "task-3-1-1.json\nИсходные данные" as Seed
participant "CatalogService\nTemplateCatalogService" as Catalog
participant Task311Commands as Commands
control CoordinationSession as Session
participant WorkflowAccessPolicy as Roles
participant "DefaultCondition\nEvaluator" as Evaluator
collections "Память сеанса\nОбъекты, шаблоны,\nснимки процессов" as Memory
participant CoordinationJournal as Journal
database "journal.jsonl\nРезультаты команд" as Log

group Загрузка веб-сеанса
  Web -> Scenario : task311() / openTask311()
  Scenario -> Seed : Прочитать JSON
  Seed --> Scenario : Каталог и объекты
  Scenario -> Catalog : Проверить модели
  Scenario -> Session : Создать сеанс
  Session -> Memory : Загрузить исходные данные\n(процессы ещё не запущены)
end

User -> Browser : Запуск или действие
Browser -> Web : POST /api/commands
Web -> Commands : submit(rawCommand)
Commands -> Session : submit(...)\nТип, ID и исходный JSON

opt Команда имеет обязательные поля
  Session -> Memory : Найти объект, шаблон его класса и снимок
  alt START
    Session -> Roles : hasRole(user, createRoles)
    Session -> Session : Выбрать начальное состояние
  else ACTION
    Session -> Roles : requireStateAccess(user, state)
    Session -> Session : Найти переходы по состоянию и действию
    opt У перехода задано условие
      Session -> Session : Вычислить ДНФ
      Session -> Evaluator : evaluatePredicate(...)
      Evaluator -> Catalog : getEffectiveParameters(classId)
    end
    Session -> Session : Выбрать единственный подходящий переход
  end
end

Session -> Journal : append(Entry)\nSUCCESS, REJECTED или ERROR
Journal -> Log : Дописать строку JSONL
opt Шаг принят и запись успешна
  Session -> Memory : Сохранить ProcessSnapshot
end
Session --> Commands : Entry
Commands --> Web : Результат команды
Web --> Browser : HTTP-ответ с результатом
Browser --> User : Состояние или причина отказа
@enduml
